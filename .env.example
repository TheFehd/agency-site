# The production site URL is NOT an environment variable. It is hardcoded as
# SITE_URL in src/content/site.ts so it can never resolve to a preview domain.

# Cal.com — your event path, e.g. username/30min
NEXT_PUBLIC_CALCOM_LINK=fehd-tassi-sd90rd/30min
NEXT_PUBLIC_CALCOM_THEME=light

# Contact form (optional — without these, API returns mailto fallback)
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@hustlgram.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
